{
  "mcpServers": {
    "entrabot": {
      "type": "stdio",
      "command": ".venv/bin/entrabot-mcp",
      "args": [],
      "env": {
        "PERSONA_SATI_MCP_URL": "<your persona-sati base URL>",
        "PERSONA_SATI_MCP_TOKEN_COMMAND": "<absolute path to your persona-sati token command>"
      },
      "description": "EntraBot Agent Identity — Teams tools + background DM/email poll. On Windows the command is the absolute path to .venv\\Scripts\\entrabot-mcp.exe (backslashes doubled in JSON); scripts\\setup-windows.cmd writes this entry for you."
    },
    "persona-sati": {
      "type": "stdio",
      "command": "<absolute path to the client launcher from your persona-sati install>",
      "args": [],
      "env": {},
      "description": "Persona-sati — personality, memory, and behavioral rules (optional). Delete this entry and the PERSONA_SATI_* env vars above to run standalone. Setup is covered by your persona-sati install's own setup documentation."
    }
  }
}
